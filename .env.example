# Copier en .env et adapter selon le deploiement.

# IaaS (PostgreSQL installe sur la meme VM) :
DATABASE_URL=postgres://cloud:cloud@localhost:5432/cloud_comparison

# PaaS / DB managee : utiliser l'URL fournie par la plateforme et activer le SSL
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PGSSL=require

PORT=3000
